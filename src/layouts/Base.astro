---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0c0b" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..900&family=Familjen+Grotesk:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230b0c0b'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='19' font-weight='800' fill='%23e4e0d3' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E"
    />
  </head>

  <body class="grain">
    <div id="progress"></div>
    <div id="cursor"></div>
    <slot />

    <script is:inline>
      (() => {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // ---- loader: count to 100, then hand off to the hero sequence -----
        const loader = document.getElementById("loader");
        const num = document.getElementById("count");

        function startHero() {
          document.querySelectorAll("[data-hero]").forEach((el) => el.classList.add("in"));
        }

        function finish() {
          if (!loader) return startHero();
          loader.classList.add("done");
          // Start the hero as the loader is fading, not after — the two
          // overlapping is what makes the entrance feel like one movement.
          setTimeout(startHero, 120);
          setTimeout(() => loader.remove(), 900);
        }

        if (reduced || !loader || !num) {
          loader?.remove();
          startHero();
        } else {
          const t0 = performance.now();
          const DUR = 1500;
          const tick = (t) => {
            const p = Math.min(1, (t - t0) / DUR);
            // ease-out so the counter decelerates into 100 rather than
            // hitting it at full speed
            const eased = 1 - Math.pow(1 - p, 3);
            num.textContent = String(Math.round(eased * 100)).padStart(3, "0");
            if (p < 1) requestAnimationFrame(tick);
            else setTimeout(finish, 260);
          };
          requestAnimationFrame(tick);
        }

        // ---- scroll reveals ------------------------------------------------
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("in");
              io.unobserve(e.target); // reveal once; re-animating on scroll-up is nausea
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
        );
        document
          .querySelectorAll(".pre:not([data-hero]), .mask:not([data-hero]), .wipe, .chars:not([data-hero])")
          .forEach((el) => io.observe(el));

        // ---- progress bar (fallback where scroll timelines are unsupported) --
        const bar = document.getElementById("progress");
        if (bar && !CSS.supports("animation-timeline: scroll()")) {
          let queued = false;
          addEventListener(
            "scroll",
            () => {
              if (queued) return;
              queued = true;
              requestAnimationFrame(() => {
                const max = document.body.scrollHeight - innerHeight;
                bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
                queued = false;
              });
            },
            { passive: true },
          );
        }

        if (reduced) return;

        // ---- hero parallax ---------------------------------------------------
        // The plate drifts at a third of scroll speed. Written against a cached
        // node and rAF-throttled — a layout read per scroll event is how these
        // end up janky.
        const plate = document.querySelector("[data-parallax]");
        if (plate) {
          let pending = false;
          addEventListener(
            "scroll",
            () => {
              if (pending) return;
              pending = true;
              requestAnimationFrame(() => {
                const y = Math.min(scrollY, innerHeight) * 0.34;
                plate.style.transform = `translate3d(0, ${y}px, 0)`;
                pending = false;
              });
            },
            { passive: true },
          );
        }

        // ---- cursor ----------------------------------------------------------
        const cur = document.getElementById("cursor");
        if (cur && matchMedia("(hover: hover) and (pointer: fine)").matches) {
          let cx = 0, cy = 0, tx = 0, ty = 0, raf = 0;
          const loop = () => {
            // Lerp toward the pointer so the dot trails rather than sticks —
            // the lag is the whole effect.
            cx += (tx - cx) * 0.18;
            cy += (ty - cy) * 0.18;
            cur.style.translate = `${cx}px ${cy}px`;
            raf = requestAnimationFrame(loop);
          };
          addEventListener("pointermove", (e) => {
            tx = e.clientX;
            ty = e.clientY;
            cur.classList.add("on");
            if (!raf) raf = requestAnimationFrame(loop);
          });
          addEventListener("pointerdown", () => cur.classList.add("big"));
          addEventListener("pointerup", () => cur.classList.remove("big"));
          document.querySelectorAll("a, button").forEach((el) => {
            el.addEventListener("pointerenter", () => cur.classList.add("big"));
            el.addEventListener("pointerleave", () => cur.classList.remove("big"));
          });
        }

        // ---- sticky gallery --------------------------------------------------
        // Whichever case study owns the most viewport height drives the plate.
        const plates = [...document.querySelectorAll("[data-plate]")];
        const cases = [...document.querySelectorAll("[data-case]")];
        if (plates.length && cases.length) {
          const pick = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (!e.isIntersecting || e.intersectionRatio < 0.35) continue;
                const i = cases.indexOf(e.target);
                plates.forEach((p, n) => p.classList.toggle("live", n === i));
              }
            },
            { threshold: [0.35, 0.6], rootMargin: "-25% 0px -25% 0px" },
          );
          cases.forEach((c) => pick.observe(c));
        }
      })();
    </script>
  </body>
</html>
