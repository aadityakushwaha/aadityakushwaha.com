---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/img/hero.webp", Astro.site);

/**
 * One Person node with a stable @id, referenced by every article's schema.
 * Answer engines resolve "who is this" from the entity graph, and a graph with
 * one canonical node beats the same facts repeated in three shapes.
 */
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://aadityakushwaha.com/#person",
      name: "Aaditya Kushwaha",
      alternateName: "Aaditya Kushwaha — Backend & Platform Engineer",
      url: "https://aadityakushwaha.com/",
      image: ogImage.href,
      jobTitle: "Backend & Platform Engineer",
      description:
        "Backend and platform engineer working on production systems: FastAPI services, multi-tenant Postgres with row-level security, Flutter apps, and the self-hosted network they run on.",
      email: "mailto:work.aadityak@gmail.com",
      address: { "@type": "PostalAddress", addressLocality: "Lucknow", addressCountry: "IN" },
      knowsAbout: [
        "Backend engineering",
        "Python",
        "FastAPI",
        "PostgreSQL row-level security",
        "Multi-tenant architecture",
        "Redis and ElastiCache cluster mode",
        "Docker Swarm",
        "Proxmox",
        "OPNsense",
        "Model Context Protocol",
        "Rust",
        "Flutter",
      ],
      sameAs: [
        "https://github.com/aadityakushwaha",
        "https://linkedin.com/in/aadityakushwaha",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://aadityakushwaha.com/#website",
      url: "https://aadityakushwaha.com/",
      name: "Aaditya Kushwaha",
      description,
      inLanguage: "en",
      publisher: { "@id": "https://aadityakushwaha.com/#person" },
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonical}#page`,
      url: canonical.href,
      name: title,
      about: { "@id": "https://aadityakushwaha.com/#person" },
      isPartOf: { "@id": "https://aadityakushwaha.com/#website" },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Aaditya Kushwaha" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Aaditya Kushwaha — backend and platform engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content="Aaditya Kushwaha" />
    <meta name="theme-color" content="#0b0c0b" />
    <link rel="alternate" type="application/rss+xml" title="Aaditya Kushwaha — Writing" href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..900&family=Familjen+Grotesk:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230b0c0b'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='19' font-weight='800' fill='%23e4e0d3' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E"
    />
  </head>

  <body class="grain">
    <div id="progress"></div>
    <div id="cursor"></div>
    <slot />

    <script>
      import "../scripts/motion";
      import "../scripts/contact";
    </script>
</body>
</html>
