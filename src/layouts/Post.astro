---
import "../styles/global.css";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    status?: string;
    hero?: string;
    kicker?: string;
    figure?: string;
    figureAlt?: string;
    panels?: { label: string; value: string; note?: string }[];
  };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter: fm, headings = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shown = new Date(fm.date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const toc = headings.filter((h) => h.depth === 2);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fm.title} — Aaditya Kushwaha</title>
    <meta name="description" content={fm.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={fm.title} />
    <meta property="og:description" content={fm.description} />
    <meta name="theme-color" content="#0b0c0b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..900&family=Familjen+Grotesk:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230b0c0b'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='19' font-weight='800' fill='%23e4e0d3' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E"
    />
  </head>

  <body class="grain">
    <div id="progress"></div>
    <div id="cursor"></div>
    <div class="nav-fade"></div>

    <header class="fixed inset-x-0 top-0 z-50">
      <nav class="flex items-center justify-between px-6 py-5 md:px-10">
        <a href="/" class="font-display text-sm font-black tracking-tight text-bone">AK</a>
        <a href="/#writing" class="ul font-body text-xs uppercase tracking-[0.18em] text-bone">← All writing</a>
      </nav>
    </header>

    <!-- ====================================================== article hero -->
    <section class="scrim relative overflow-hidden px-6 pb-10 pt-28 md:px-10 md:pt-36">
      {fm.hero && (
        <img
          data-drift
          class="dissolve pointer-events-none absolute inset-x-0 top-0 h-[130%] w-full object-cover opacity-40"
          src={fm.hero}
          alt=""
          aria-hidden="true"
          width="1376"
          height="768"
        />
      )}
      <div class="relative mx-auto max-w-[78rem]">
        <p data-rise class="eyebrow">{fm.kicker ?? "Writing"}</p>
        <h1 data-rise class="legible mt-4 max-w-[20ch] font-display text-4xl font-black uppercase leading-[0.9] tracking-[-0.025em] md:text-7xl">
          {fm.title}
        </h1>
        <p data-rise class="legible mt-6 max-w-[56ch] font-editorial text-xl italic leading-snug text-bone md:text-2xl">
          {fm.description}
        </p>
        <p data-rise class="mt-7 font-body text-xs uppercase tracking-[0.2em] text-muted">
          {shown}{fm.status ? ` · ${fm.status}` : ""} · Aaditya Kushwaha
        </p>
      </div>
    </section>

    <!-- ============================================ rails + reading column -->
    <div class="mx-auto grid max-w-[78rem] gap-10 px-6 pb-24 md:px-10 lg:grid-cols-12 lg:gap-12">
      <!-- left rail: contents -->
      <aside class="hidden lg:col-span-3 lg:block">
        <div class="sticky top-28">
          <p class="eyebrow mb-4">Contents</p>
          <nav class="flex flex-col">
            {toc.map((h) => (
              <a
                href={`#${h.slug}`}
                data-toc={h.slug}
                class="ul border-t border-hair/60 py-2.5 font-body text-sm leading-snug text-muted transition-colors hover:text-bone"
              >
                {h.text}
              </a>
            ))}
          </nav>

          {fm.panels && (
            <div class="mt-10">
              <p class="eyebrow mb-4">By the numbers</p>
              {fm.panels.map((p) => (
                <div class="border-t border-hair/60 py-3">
                  <span class="block font-display text-2xl font-black tabular-nums text-sage">{p.value}</span>
                  <span class="block font-body text-[11px] uppercase leading-tight tracking-[0.14em] text-muted">{p.label}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </aside>

      <!-- reading column -->
      <article class="lg:col-span-6">
        <div class="prose-post">
          <slot />
        </div>

        <hr class="mt-16 border-hair" />
        <div class="mt-7 flex flex-wrap items-center justify-between gap-4">
          <p class="font-body text-sm text-bone-dim">
            Written by Aaditya Kushwaha —
            <a class="ul" href="mailto:work.aadityak@gmail.com">get in touch</a>
          </p>
          <a href="/#writing" class="ul font-body text-xs uppercase tracking-[0.18em] text-bone">More writing →</a>
        </div>
      </article>

      <!-- right rail: figure + elsewhere -->
      <aside class="lg:col-span-3">
        <div class="sticky top-28 flex flex-col gap-8">
          {fm.figure && (
            <figure>
              <img data-wipe class="dissolve-all w-full object-cover" src={fm.figure} alt={fm.figureAlt ?? ""} width="880" height="660" loading="lazy" />
              {fm.figureAlt && (
                <figcaption class="mt-3 font-body text-[12px] leading-snug text-muted">{fm.figureAlt}</figcaption>
              )}
            </figure>
          )}

          <div>
            <p class="eyebrow mb-3">The tool</p>
            <a href="https://github.com/aadityakushwaha/worklog-mcp" target="_blank" rel="noopener"
              class="group block border-t border-hair/60 py-3">
              <span class="block font-display text-lg font-black uppercase tracking-tight transition-colors group-hover:text-sage">worklog-mcp</span>
              <span class="mt-1 block font-body text-[13px] leading-snug text-bone-dim">
                MIT · TypeScript · one block of config
              </span>
            </a>
          </div>

          <div>
            <p class="eyebrow mb-3">Elsewhere</p>
            <p class="font-body text-sm text-bone">
              <a class="ul" href="https://github.com/aadityakushwaha" target="_blank" rel="noopener">GitHub</a> ·
              <a class="ul" href="https://linkedin.com/in/aadityakushwaha" target="_blank" rel="noopener">LinkedIn</a>
            </p>
          </div>
        </div>
      </aside>
    </div>

    <script>
      import "../scripts/motion";
      import "../scripts/toc";
    </script>

    <style is:global>
      /* Long-form reading rules. Measure sits near 68 characters and the type is
         a touch larger than UI text — an article is read, not scanned. */
      .prose-post { font-size: 17.5px; line-height: 1.75; color: var(--color-bone-dim); }
      .prose-post > * + * { margin-top: 1.4em; }
      .prose-post > p:first-child::first-letter {
        float: left;
        margin: 0.06em 0.09em 0 0;
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 3.4em;
        line-height: 0.78;
        color: var(--color-bone);
      }
      .prose-post h2 {
        margin-top: 2.8em;
        padding-top: 1.1em;
        border-top: 1px solid var(--color-hair);
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.6rem;
        line-height: 1.08;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        color: var(--color-bone);
        scroll-margin-top: 7rem;
      }
      .prose-post h3 {
        margin-top: 2em;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--color-bone);
      }
      .prose-post strong { color: var(--color-bone); font-weight: 600; }
      .prose-post em { font-family: var(--font-editorial); font-style: italic; font-size: 1.08em; }
      .prose-post a {
        color: var(--color-bone);
        text-decoration: underline;
        text-decoration-color: var(--color-sage);
        text-underline-offset: 3px;
      }
      .prose-post a:hover { color: var(--color-sage); }
      .prose-post ul, .prose-post ol { padding-left: 1.15em; }
      .prose-post li { margin-top: 0.55em; }
      .prose-post li::marker { color: var(--color-sage); }
      .prose-post code {
        font-size: 0.86em;
        background: var(--color-raise);
        border: 1px solid var(--color-hair);
        padding: 0.1em 0.36em;
        border-radius: 3px;
        color: var(--color-bone);
      }
      /* Code panels break the measure deliberately — they are specimens, not prose. */
      .prose-post pre {
        overflow-x: auto;
        background: var(--color-raise);
        border: 1px solid var(--color-hair);
        border-left: 2px solid var(--color-sage);
        padding: 1.15rem 1.25rem;
        font-size: 0.84em;
        line-height: 1.62;
      }
      .prose-post pre code { background: none; border: 0; padding: 0; }
      .prose-post table { width: 100%; border-collapse: collapse; font-size: 0.93em; display: block; overflow-x: auto; }
      .prose-post th, .prose-post td { text-align: left; padding: 0.6em 0.9em; border-bottom: 1px solid var(--color-hair); }
      .prose-post th {
        font-family: var(--font-body);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-muted);
        border-bottom: 1px solid var(--color-sage);
        white-space: nowrap;
      }
      /* Pull-quote panel: the one place the reading column is allowed to shout. */
      .prose-post blockquote {
        margin-left: -1.25rem;
        margin-right: -1.25rem;
        padding: 1.4rem 1.5rem;
        background: var(--color-raise);
        border-left: 2px solid var(--color-sage);
        font-family: var(--font-editorial);
        font-style: italic;
        font-size: 1.28em;
        line-height: 1.4;
        color: var(--color-bone);
      }
      .prose-post hr { border: 0; border-top: 1px solid var(--color-hair); margin: 2.8em 0; }
      .prose-post img { width: 100%; }
      @media (max-width: 640px) {
        .prose-post blockquote { margin-left: 0; margin-right: 0; }
      }
    </style>
  </body>
</html>
