---
import "../styles/global.css";

interface Props {
  frontmatter: { title: string; description: string; date: string; status?: string };
}
const { frontmatter: fm } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shown = new Date(fm.date).toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fm.title} — Aaditya Kushwaha</title>
    <meta name="description" content={fm.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={fm.title} />
    <meta property="og:description" content={fm.description} />
    <meta name="theme-color" content="#0b0c0b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..900&family=Familjen+Grotesk:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230b0c0b'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='19' font-weight='800' fill='%23e4e0d3' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E"
    />
  </head>

  <body class="grain">
    <header class="fixed inset-x-0 top-0 z-50 mix-blend-difference">
      <nav class="flex items-center justify-between px-6 py-6 md:px-10">
        <a href="/" class="font-display text-sm font-black tracking-tight text-bone">AK</a>
        <a href="/#writing" class="ul font-body text-xs uppercase tracking-[0.18em] text-bone">All writing</a>
      </nav>
    </header>

    <article class="mx-auto max-w-[42rem] px-6 pb-28 pt-32 md:pt-44">
      <p class="font-body text-xs uppercase tracking-[0.22em] text-sage">
        {shown}{fm.status ? ` — ${fm.status}` : ""}
      </p>

      <h1 class="mt-5 font-display text-4xl font-black uppercase leading-[0.92] tracking-[-0.02em] md:text-6xl">
        {fm.title}
      </h1>

      <div class="prose-post mt-12">
        <slot />
      </div>

      <hr class="mt-20 border-hair" />
      <p class="mt-7 font-body text-sm text-bone-dim">
        Written by Aaditya Kushwaha —
        <a class="ul" href="mailto:work.aadityak@gmail.com">work.aadityak@gmail.com</a> ·
        <a class="ul" href="https://github.com/aadityakushwaha" target="_blank" rel="noopener">GitHub</a> ·
        <a class="ul" href="https://linkedin.com/in/aadityakushwaha" target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </article>

    <style is:global>
      /* Long-form reading rules. Measure is capped near 68 characters and the
         type is a touch larger than UI text — an article is read, not scanned. */
      .prose-post {
        font-size: 17px;
        line-height: 1.72;
        color: var(--color-bone-dim);
      }
      .prose-post > * + * { margin-top: 1.35em; }
      .prose-post h2 {
        margin-top: 2.6em;
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.55rem;
        line-height: 1.1;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        color: var(--color-bone);
      }
      .prose-post h3 {
        margin-top: 2em;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--color-bone);
      }
      .prose-post strong { color: var(--color-bone); font-weight: 600; }
      .prose-post em { font-family: var(--font-editorial); font-style: italic; font-size: 1.08em; }
      .prose-post a {
        color: var(--color-bone);
        text-decoration: underline;
        text-decoration-color: var(--color-sage);
        text-underline-offset: 3px;
      }
      .prose-post a:hover { color: var(--color-sage); }
      .prose-post ul, .prose-post ol { padding-left: 1.15em; }
      .prose-post li { margin-top: 0.5em; }
      .prose-post li::marker { color: var(--color-sage); }
      .prose-post code {
        font-size: 0.88em;
        background: var(--color-raise);
        border: 1px solid var(--color-hair);
        padding: 0.1em 0.36em;
        border-radius: 3px;
        color: var(--color-bone);
      }
      .prose-post pre {
        overflow-x: auto;
        background: var(--color-raise);
        border: 1px solid var(--color-hair);
        padding: 1.1rem 1.2rem;
        border-radius: 4px;
        font-size: 0.85em;
        line-height: 1.6;
      }
      .prose-post pre code { background: none; border: 0; padding: 0; }
      /* Tables scroll inside their own box so the article never scrolls sideways */
      .prose-post table { width: 100%; border-collapse: collapse; font-size: 0.92em; display: block; overflow-x: auto; }
      .prose-post th, .prose-post td { text-align: left; padding: 0.55em 0.85em; border-bottom: 1px solid var(--color-hair); }
      .prose-post th {
        font-family: var(--font-body);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-muted);
        border-bottom: 1px solid var(--color-sage);
        white-space: nowrap;
      }
      .prose-post blockquote {
        border-left: 2px solid var(--color-sage);
        padding-left: 1.1rem;
        font-family: var(--font-editorial);
        font-style: italic;
        font-size: 1.15em;
        color: var(--color-bone);
      }
      .prose-post hr { border: 0; border-top: 1px solid var(--color-hair); margin: 2.6em 0; }
    </style>
  </body>
</html>
