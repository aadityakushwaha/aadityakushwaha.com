---
import Base from "../layouts/Base.astro";

const stats = [
  { n: 4000, s: "+", l: "Commits, last 24 months" },
  { n: 11, s: "", l: "Organisations shipped for" },
  { n: 233, s: "k", l: "Companies in one pipeline" },
  { n: 65, s: "", l: "Nodes on the private mesh" },
];

const systems = [
  {
    n: "01", name: "Ride-hailing platform", org: "Aerovahan", years: "2025 — 2026",
    body: "Dispatch and matching for a live marketplace: driver-offer caps, radius expansion, dynamic surge, hot-zone broadcast, demand forecasting, and a rider–driver bid flow. I owned the backend, the admin console, and both Flutter apps.",
    facts: ["863 commits", "94 routers", "110 services", "98 migrations", "~135k lines"],
    stack: "FastAPI · SQLAlchemy 2 async · Postgres · Redis · Next.js · Flutter",
    note: "Diagnosed a production outage caused by ElastiCache cluster-mode semantics — cross-slot deletes, blocked KEYS scans, and a single Uvicorn worker taking health checks down with it.",
  },
  {
    n: "02", name: "School-transport safety", org: "Aero Squad", years: "2026",
    body: "Parents watch a bus in real time; schools verify arrivals with a TOTP gate check that works with no signal. Geofenced trips over OSRM map-matching, and a KYC pipeline doing DigiLocker lookups, OCR and face-to-document matching behind circuit breakers.",
    facts: ["372 commits", "22 screens", "0 → shipped in 10 weeks"],
    stack: "FastAPI · PostGIS · OSRM · Flutter · Riverpod · arq",
    note: "Every external API sits behind a breaker, because a KYC provider timing out should slow one onboarding, not the fleet.",
  },
  {
    n: "03", name: "Multi-tenant AI LMS", org: "Blitzlearning", years: "2026",
    body: "Tenant isolation enforced by Postgres row-level security rather than application code — the database refuses cross-tenant reads even when the app is wrong. SCORM, cmi5 and AICC delivery, white-labelled per tenant.",
    facts: ["415 commits", "RLS at the database", "pgvector + Meilisearch"],
    stack: "FastAPI · Postgres 16 · pgvector · Next.js 14 · Turborepo · uv",
    note: "Isolation you can test: the integration suite asserts a tenant cannot read another's rows even with a forged tenant id.",
  },
  {
    n: "04", name: "The network it runs on", org: "Altacee", years: "2024 — now",
    body: "Designed and operate the estate end to end: dual-WAN with failover, 802.1Q segmentation across three isolated networks, RSTP bridges on redundant NIC pairs. Internal services have no public listener at all — reachable only across the mesh.",
    facts: ["17 interfaces", "2 Proxmox estates", "18 VMs", "~65-node tailnet"],
    stack: "OPNsense · Proxmox · Docker Swarm · Traefik · Tailscale · Cloudflare",
    note: "Provisioning, firewall changes and DNS run through an MCP server as typed, audited operations rather than console clicks.",
  },
];

const roles = [
  { years: "2025 — 2026", org: "Aerovahan", title: "Full-Stack Engineer", what: "Ride-hailing platform and school-transport safety — backend, console, vendor portal, two Flutter apps." },
  { years: "2023 — now", org: "Altacee", title: "Full-Stack & Platform Engineer", what: "Product studio. Multi-tenant LMS, marketing suite, CRM, self-hosted platform and network." },
  { years: "2024 — 2025", org: "AIKO-1", title: "Full-Stack Engineer", what: "Consumer Flutter app, bulk image generation, investor tooling, messaging and ad services." },
  { years: "2025", org: "The HW Store", title: "Engineer", what: "Collector app, marketplace crawler, ML pricing service, unified search API." },
  { years: "2024 — 2025", org: "Cyber-Team", title: "Security Engineer", what: "Security research and CTF work with the team; write-ups and internal course material." },
  { years: "2023 — 2026", org: "Kazmik Group", title: "Engineer", what: "LMS, payments with an operations dashboard, event management, salon booking." },
  { years: "2022 — now", org: "LUGVITC", title: "Member & Contributor", what: "University Linux Users Group. Contributed to the group's public site; ran workshops and events." },
];

const caps = [
  { k: "Languages", v: "Python · TypeScript · Dart · Go · Swift · SQL · C++" },
  { k: "Backend", v: "FastAPI · SQLAlchemy 2 async · Alembic · Celery · arq · pytest · OpenAPI · WebSockets · SSE" },
  { k: "Frontend", v: "Next.js App Router · React · Astro · Angular · Tailwind · TanStack Query · Zustand · deck.gl" },
  { k: "Mobile", v: "Flutter · Riverpod · go_router · Dio · live activities · offline-first sync" },
  { k: "Data", v: "PostgreSQL · PostGIS · pgvector · row-level security · Redis · Meilisearch · MinIO" },
  { k: "Infrastructure", v: "Docker Swarm · Traefik · Proxmox · OPNsense · Tailscale · AWS · Cloudflare · GitHub Actions" },
  { k: "AI", v: "MCP server development · Anthropic & Gemini APIs · pgvector RAG · agent orchestration" },
];

// Only repositories I actually committed to, with my own commit count rather
// than the repo's star count — stars measure a project, commits measure me.
const oss = [
  { name: "worklog-mcp", meta: "Author", note: "Six tools that let a coding agent record what it did and why. JSONL, no backend.", href: "https://github.com/aadityakushwaha/worklog-mcp" },
  { name: "dockation", meta: "10 commits", note: "Docker orchestration helper in Go.", href: "https://github.com/Altacee/dockation" },
  { name: "webrtc-karaoke", meta: "8 commits", note: "Peer-to-peer karaoke over WebRTC — signalling, media negotiation, sync.", href: "https://github.com/Altacee/webrtc-karaoke" },
  { name: "DWCrawler", meta: "9 commits", note: "Tor crawler with automated content classification and structured extraction.", href: "https://github.com/aadityakushwaha/DWCrawler" },
  { name: "aVim", meta: "11 commits", note: "Neovim configuration in Lua — LSP, treesitter, tuned for Python and TypeScript.", href: "https://github.com/aadityakushwaha/aVim" },
  { name: "lugvitc.github.io", meta: "10 commits", note: "Landing site for the university Linux Users Group.", href: "https://github.com/lugvitc/lugvitc.github.io" },
];

const marquee = ["FASTAPI", "POSTGRESQL", "ROW-LEVEL SECURITY", "REDIS", "POSTGIS", "PGVECTOR", "FLUTTER", "NEXT.JS", "TYPESCRIPT", "PROXMOX", "TAILSCALE", "OPNSENSE", "DOCKER SWARM", "MCP", "ARQ", "TRAEFIK"];

// Newest first. `read` is the same string the article's own header shows.
const posts = [
  {
    href: "/writing/agent-review-gap/",
    title: "61% of AI-authored pull requests are never reviewed",
    note: "What we removed when the author stopped being someone you could ask.",
    read: "8 min",
    date: "17 Aug 2026",
  },
  {
    href: "/writing/the-backup-that-failed-in-ninety-milliseconds/",
    title: "The backup that failed in ninety milliseconds",
    note: "Three weeks of nightly failures, every one recorded and never surfaced.",
    read: "8 min",
    date: "17 Aug 2026",
  },
  {
    href: "/writing/one-pdf-at-a-time/",
    title: "One PDF at a time",
    note: "pdfium crashes two ways, and the fix moves the parallelism to processes.",
    read: "8 min",
    date: "17 Aug 2026",
  },
  {
    href: "/writing/two-ways-a-parser-lies/",
    title: "Two ways a parser lies about being right",
    note: "A fabricated zero, and a score measured on the field you matched by.",
    read: "9 min",
    date: "17 Aug 2026",
  },
  {
    href: "/writing/the-document-your-editor-rewrote/",
    title: "The document your editor quietly rewrote",
    note: "Ten data-loss findings. The one still open destroys content on open.",
    read: "11 min",
    date: "16 Aug 2026",
  },
  {
    href: "/writing/elasticache-cluster-mode/",
    title: "The outage that taught me ElastiCache cluster mode",
    note: "KEYS is blocked, deletes cross slots, and one Uvicorn worker takes the health check down with it.",
    read: "9 min",
    date: "17 Aug 2026",
  },
  {
    href: "/writing/rls-below-the-application/",
    title: "Multi-tenant isolation below the application",
    note: "Postgres RLS, and what breaks when the policy is subtly wrong.",
    read: "10 min",
    date: "17 Aug 2026",
  },
  {
    href: "/writing/law-as-default-deny/",
    title: "Encoding the law as a default-deny",
    note: "DPDP, PECR and CAN-SPAM as reviewable code that holds rather than sends.",
    read: "9 min",
    date: "17 Aug 2026",
  },
];

const now = [
  "Building agentic infrastructure tooling at Altacee",
  "Writing up production postmortems worth reading",
  "Open to remote roles — 4+ hours EU / US-East overlap",
];
---

<Base
  title="Aaditya Kushwaha — Backend & Platform Engineer"
  description="Backend and platform engineer. Dispatch engines, multi-tenant SaaS, agentic infrastructure — and the network underneath them."
>
  <div id="loader" class="flex items-end justify-between p-6 md:p-10">
    <span class="font-body text-xs uppercase tracking-[0.3em] text-muted">Aaditya Kushwaha</span>
    <span id="count" class="font-display text-[22vw] leading-[0.78] font-black text-raise tabular-nums md:text-[15vw]">000</span>
  </div>

  <div class="nav-fade"></div>
  <header class="fixed inset-x-0 top-0 z-50">
    <nav class="flex items-center justify-between px-6 py-5 md:px-10 xl:px-16 2xl:px-24">
      <a href="/" class="font-display text-sm font-black tracking-tight text-bone">AK</a>
      <div class="flex gap-5 font-body text-[11px] uppercase tracking-[0.18em] text-bone md:gap-9 md:text-xs">
        <a href="#work" class="ul hidden sm:inline">Work</a>
        <a href="#systems" class="ul">Systems</a>
        <a href="#experience" class="ul hidden sm:inline">Experience</a>
        <a href="#writing" class="ul">Writing</a>
        <a href="#contact" class="ul">Contact</a>
      </div>
    </nav>
  </header>

  <!-- ============================================================= hero -->
  <section data-hero-section class="relative flex min-h-[86svh] flex-col overflow-hidden px-6 pb-6 pt-24 md:px-10 xl:px-16 2xl:px-24 md:pb-8">
    <!--
      The plate opens as an inset, rounded frame and expands to full bleed as
      the hero scrolls away — the container itself is the transition, so the
      page appears to open rather than to scroll.
    -->
    <div data-frame class="hero-art scrim">
      <!-- The LCP element. AVIF first (≈20% smaller than WebP here), eager, and
           high priority so it is not queued behind the font stylesheet. -->
      <picture>
        <source srcset="/img/hero.avif" type="image/avif" />
        <img data-parallax src="/img/hero.webp" alt="" width="1376" height="768"
          fetchpriority="high" decoding="async" /></picture>
    </div>

    <div class="relative z-10 flex flex-1 flex-col justify-end">

      <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10">
        <div class="name-fit lg:col-span-8">
          <p data-hero class="legible mb-5 font-body text-base text-bone md:text-lg">
            I build <span data-stack class="stack"
              ><span class="sr-only">systems</span
              ><span class="stack-item" aria-hidden="true">systems</span
              ><span class="stack-item" aria-hidden="true">backends</span
              ><span class="stack-item" aria-hidden="true">platforms</span
              ><span class="stack-item" aria-hidden="true">networks</span
            ></span> that carry load — and stay explainable at 3am.
          </p>

          <h1 class="legible font-display font-black uppercase leading-[0.8] tracking-[-0.038em]">
            <span class="sr-only">Aaditya Kushwaha</span>
            <span class="mask block" aria-hidden="true">
              <span data-chars class="name-line name-line--1">
                {"Aaditya".split("").map((c) => <span class="inline-block">{c}</span>)}
              </span>
            </span>
            <span class="mask block" aria-hidden="true">
              <span data-chars class="name-line name-line--2 text-sage">
                {"Kushwaha".split("").map((c) => <span class="inline-block">{c}</span>)}
              </span>
            </span>
          </h1>
        </div>

        <!-- A live index of what is below, so the first screen already shows
             the work rather than only announcing a name. -->
        <nav data-group class="hidden lg:col-span-4 lg:block">
          <p class="eyebrow mb-4">Selected systems</p>
          {systems.map((sys) => (
            <a href="#systems" class="group flex items-baseline gap-4 border-t border-hair/60 py-2.5">
              <span class="font-display text-xs font-black tabular-nums text-sage">{sys.n}</span>
              <span class="flex-1 font-body text-sm text-bone transition-colors group-hover:text-sage">{sys.name}</span>
              <span class="font-body text-[11px] uppercase tracking-[0.14em] text-muted">{sys.org}</span>
            </a>
          ))}
        </nav>
      </div>

      <div data-hero class="mt-10 flex flex-wrap items-end justify-between gap-5">
        <p class="font-body text-sm uppercase leading-snug tracking-[0.12em] text-muted">
          <span class="block">Backend · Platform · Agentic systems</span>
          <span class="mt-1 block font-editorial text-base normal-case italic tracking-normal text-bone-dim">
            four years, mostly in production
          </span>
        </p>
        <p class="font-body text-xs uppercase tracking-[0.18em] text-muted">Lucknow, India — remote</p>
      </div>

      <!-- Numbers in the hero so the first screen carries evidence, not just a name. -->
      <div data-hero class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-hair pt-5 md:grid-cols-4">
        {stats.map((st) => (
          <div>
            <span
              data-num={st.n}
              data-suffix={st.s}
              class="block font-display text-2xl font-black tabular-nums text-bone md:text-4xl"
            >0{st.s}</span>
            <span class="mt-0.5 block font-body text-[11px] uppercase leading-tight tracking-[0.14em] text-muted">{st.l}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================== marquee -->
  <div class="overflow-hidden border-y border-hair py-3">
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {marquee.map((m) => (
            <span class="flex items-center whitespace-nowrap font-body text-xs uppercase tracking-[0.25em] text-muted">
              <span class="px-6">{m}</span><span class="text-sage">/</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>


  <!-- ============================================================ flood -->
  <section class="flood scrim my-4 flex min-h-[56svh] items-center py-24 md:my-8 md:min-h-[62svh] md:py-28">
    <div class="dissolve absolute inset-0 overflow-hidden">
        <img data-drift src="/img/flood-1.webp" alt="" aria-hidden="true" width="1376" height="768" loading="lazy" />
      </div>
    <div class="relative z-10 w-full px-6 md:px-10 xl:px-16 2xl:px-24">
      <p data-rise class="eyebrow">The work</p>
      <p data-lines class="mt-4 overflow-hidden">
        <span class="legible block font-display text-[9vw] font-black uppercase leading-[0.86] tracking-[-0.03em] md:text-[6.4vw]">Systems<br />under load</span>
      </p>
      <p data-rise class="legible mt-5 max-w-[46ch] font-editorial text-xl italic leading-snug text-bone md:text-2xl">Every number on this page came out of a repository, not a memory.</p>
    </div>
  </section>

  <!-- ============================================================ about -->
  <section id="work" class="px-6 py-20 md:px-10 xl:px-16 2xl:px-24 md:py-28">
    <div class="grid gap-10 md:grid-cols-12 md:gap-14">
      <div class="md:col-span-5">
        <img data-wipe src="/img/about.webp" alt="Abstract schematic of a distributed backend"
          class="dissolve-all negate w-full object-cover" width="880" height="1100" loading="lazy" />
      </div>

      <div class="md:col-span-7">
        <p data-rise class="font-body text-xs uppercase tracking-[0.22em] text-sage">What I actually do</p>

        <h2 data-reveal-text class="mt-5 font-editorial text-3xl italic leading-[1.18] md:text-5xl">
          <span class="reveal-word">Most</span> <span class="reveal-word">of</span> <span class="reveal-word">my</span> <span class="reveal-word">work</span> <span class="reveal-word">is</span> <span class="reveal-word">the</span> <span class="reveal-word">unglamorous</span> <span class="reveal-word">half</span> <span class="reveal-word">—</span> <span class="reveal-word">the</span> <span class="reveal-word">part</span> <span class="reveal-word">that</span> <span class="reveal-word">decides</span> <span class="reveal-word">whether</span> <span class="reveal-word">the</span> <span class="reveal-word">demo</span> <span class="reveal-word">survives</span> <span class="reveal-word">contact</span> <span class="reveal-word">with</span> <span class="reveal-word">real</span> <span class="reveal-word">traffic.</span>
        </h2>

        <div data-group class="mt-8 max-w-[62ch] space-y-4 font-body text-[15px] leading-relaxed text-bone-dim md:text-lg">
          <p>
            I've spent four years shipping production systems end to end: the FastAPI service, the Next.js console
            that operates it, the Flutter app that consumes it, and the network it runs on. Not four separate jobs —
            one system, seen from four sides.
          </p>
          <p>
            The through-line is enforcement at the right layer. Tenant isolation belongs in the database, not in a
            code review checklist. Compliance rules belong in a type-checked default-deny, not a wiki page. A circuit
            breaker belongs around every external call, because the third party <em>will</em> time out at 3am.
          </p>
          <p>
            I write about the failures because they're the part worth reading — the outage that taught me
            ElastiCache cluster mode is not Redis, and what it cost to find out.
          </p>
        </div>

        <ul data-group class="mt-9 border-t border-hair">
          {now.map((n) => (
            <li class="flex gap-4 border-b border-hair py-3 font-body text-sm text-bone">
              <span class="text-sage">→</span><span>{n}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ========================================================== systems -->
  <section id="systems" class="px-6 py-20 md:px-10 xl:px-16 2xl:px-24 md:py-28">
    <div data-rise class="mb-14 flex items-baseline justify-between pb-4">
      <h2 class="font-display text-3xl font-black uppercase tracking-tight md:text-5xl">Selected systems</h2>
      <span class="eyebrow">Four of them</span>
    </div>

    <div class="grid gap-10 md:grid-cols-12 md:gap-14">
      <div class="hidden md:col-span-5 md:block">
        <div class="dissolve-all sticky top-20 aspect-4/5">
          {systems.map((s, i) => (
            <img data-plate class="plate h-full w-full object-cover" style={i === 0 ? "opacity:1" : ""}
              src={`/img/sys-0${i + 1}.webp`} alt={`Abstract diagram — ${s.name}`}
              width="880" height="1100" loading="lazy" decoding="async" />
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-20 md:col-span-7 md:gap-36">
        {systems.map((s, i) => (
          <article data-case>
            <img data-wipe class="dissolve-all mb-6 aspect-4/5 w-full object-cover md:hidden"
              src={`/img/sys-0${i + 1}.webp`} alt="" width="880" height="1100" loading="lazy" />

            <div data-group>
              <div class="flex items-baseline gap-5">
                <span class="font-display text-5xl font-black leading-none text-hair md:text-7xl">{s.n}</span>
                <div>
                  <p class="font-body text-xs uppercase tracking-[0.2em] text-sage">{s.org}</p>
                  <p class="font-body text-xs uppercase tracking-[0.2em] text-muted">{s.years}</p>
                </div>
              </div>

              <h3 class="mt-5 font-display text-3xl font-black uppercase leading-[0.95] tracking-tight md:text-5xl">{s.name}</h3>
              <p class="mt-4 max-w-[58ch] font-body text-[15px] leading-relaxed text-bone-dim md:text-lg">{s.body}</p>

              <ul class="mt-6 flex flex-wrap gap-x-7 gap-y-2">
                {s.facts.map((f) => (
                  <li class="font-body text-sm tabular-nums text-bone"><span class="mr-2 text-sage">—</span>{f}</li>
                ))}
              </ul>

              <p class="mt-6 border-l border-sage py-1 pl-4 font-editorial text-lg italic leading-snug text-bone-dim">{s.note}</p>
              <p class="mt-5 font-body text-xs uppercase tracking-[0.15em] text-muted">{s.stack}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================================ flood -->
  <section class="flood scrim my-4 flex min-h-[56svh] items-center py-24 md:my-8 md:min-h-[62svh] md:py-28">
    <div class="dissolve absolute inset-0 overflow-hidden">
        <img data-drift src="/img/flood-3.webp" alt="" aria-hidden="true" width="1376" height="768" loading="lazy" />
      </div>
    <div class="relative z-10 w-full px-6 md:px-10 xl:px-16 2xl:px-24">
      <p data-rise class="eyebrow">Where it ran</p>
      <p data-lines class="mt-4 overflow-hidden">
        <span class="legible block font-display text-[9vw] font-black uppercase leading-[0.86] tracking-[-0.03em] md:text-[6.4vw]">Real traffic,<br />real 3am</span>
      </p>
      <p data-rise class="legible mt-5 max-w-[46ch] font-editorial text-xl italic leading-snug text-bone md:text-2xl">Four years of shipping into production, across seven organisations.</p>
    </div>
  </section>

  <!-- ======================================================= experience -->
  <section id="experience" class="relative overflow-hidden px-6 py-20 md:px-10 xl:px-16 2xl:px-24 md:py-28">
    <img data-drift src="/img/band.webp" alt="" aria-hidden="true"
      class="dissolve pointer-events-none absolute inset-0 h-[130%] w-full object-cover opacity-30" width="1600" height="686" loading="lazy" />

    <div class="relative">
      <div data-rise class="mb-12 flex items-baseline justify-between pb-4">
        <h2 class="font-display text-3xl font-black uppercase tracking-tight md:text-5xl">Experience</h2>
        <span class="eyebrow">2022 — now</span>
      </div>

      <div data-group>
        {roles.map((r) => (
          <div class="grid gap-2 border-b border-hair py-6 md:grid-cols-12 md:gap-8">
            <p class="font-body text-xs uppercase tabular-nums tracking-[0.16em] text-muted md:col-span-2">{r.years}</p>
            <p class="font-display text-lg font-black uppercase tracking-tight text-bone md:col-span-3 md:text-xl">{r.org}</p>
            <p class="font-body text-sm uppercase tracking-[0.14em] text-sage md:col-span-3">{r.title}</p>
            <p class="font-body text-sm text-bone-dim md:col-span-4">{r.what}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================== capabilities -->
  <section class="relative overflow-hidden px-6 py-20 md:px-10 xl:px-16 2xl:px-24 md:py-28">
    <div data-rise class="mb-12 flex items-baseline justify-between pb-4">
      <h2 class="font-display text-3xl font-black uppercase tracking-tight md:text-5xl">Capabilities</h2>
      <span class="eyebrow">Things I've shipped with</span>
    </div>

    <div class="grid gap-10 md:grid-cols-12 md:gap-14">
      <div data-group class="md:col-span-7">
        {caps.map((c) => (
          <div class="grid grid-cols-1 gap-1 border-b border-hair py-4 md:grid-cols-4 md:gap-6">
            <p class="font-body text-xs uppercase tracking-[0.18em] text-sage">{c.k}</p>
            <p class="font-body text-sm leading-relaxed text-bone-dim md:col-span-3">{c.v}</p>
          </div>
        ))}
      </div>
      <div class="md:col-span-5">
        <img data-wipe src="/img/stack.webp" alt="Abstract layered infrastructure cross-section"
          class="dissolve-all negate w-full object-cover" width="1376" height="768" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ============================================================== oss -->
  <section class="px-6 py-20 md:px-10 xl:px-16 2xl:px-24 md:py-28">
    <div data-rise class="mb-10 flex items-baseline justify-between pb-4">
      <h2 class="font-display text-3xl font-black uppercase tracking-tight md:text-5xl">Open source</h2>
      <span class="eyebrow">Repos I committed to</span>
    </div>

    <ul data-group>
      {oss.map((o) => (
        <li class="border-b border-hair">
          <!--
            Grid, not a flex row with a fixed-width name. `lugvitc.github.io`
            renders wider than any column you'd pick, and md:w-64 made it
            overflow straight across the description. The name column now
            shrinks, and break-words gives the dots somewhere to break.
          -->
          <a href={o.href} target="_blank" rel="noopener"
            class="group grid gap-x-8 gap-y-2 py-6 md:grid-cols-12 md:items-baseline">
            <span class="min-w-0 break-words font-display text-xl font-black uppercase leading-[1.05] tracking-tight transition-colors group-hover:text-sage md:col-span-4 md:text-2xl">{o.name}</span>
            <span class="min-w-0 font-body text-sm text-bone-dim md:col-span-6 md:text-base">{o.note}</span>
            <span class="font-body text-xs uppercase tracking-[0.2em] text-muted md:col-span-2 md:text-right">{o.meta}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ========================================================== writing -->
  <section id="writing" class="px-6 py-20 md:px-10 xl:px-16 2xl:px-24 md:py-28">
    <div data-rise class="mb-10 flex items-baseline justify-between pb-4">
      <h2 class="font-display text-3xl font-black uppercase tracking-tight md:text-5xl">Writing</h2>
      <a href="/writing/" class="ul eyebrow">All postmortems →</a>
    </div>

    <p data-rise class="max-w-[58ch] font-editorial text-xl italic leading-snug text-bone-dim md:text-2xl">
      Things that broke in production, and what the fix actually was.
    </p>

    <ul data-group class="mt-10">
      {posts.map((p) => (
        <li class="border-t border-hair">
          <a href={p.href} class="group flex flex-col gap-2 py-6 md:flex-row md:items-baseline md:gap-10">
            <span class="shrink-0 font-body text-xs uppercase tracking-[0.2em] text-sage md:w-44">
              {p.date} · {p.read}
            </span>
            <span class="block">
              <h3 class="max-w-[26ch] font-display text-2xl font-black uppercase leading-[0.98] tracking-tight transition-colors group-hover:text-sage md:text-4xl">
                {p.title}
              </h3>
              <p class="mt-3 max-w-[58ch] font-body text-sm text-bone-dim">{p.note}</p>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>



  <!-- ========================================================== contact -->
  <footer id="contact" class="relative overflow-hidden px-6 py-20 md:px-10 xl:px-16 2xl:px-24 md:py-28">
    <img data-drift src="/img/contact.webp" alt="" aria-hidden="true"
      class="dissolve pointer-events-none absolute inset-0 h-[130%] w-full object-cover opacity-45" width="1600" height="686" loading="lazy" />

    <div class="relative">
      <p data-rise class="font-body text-xs uppercase tracking-[0.25em] text-sage">Open to remote work — available now</p>

      <h2 data-rise class="mt-5 max-w-[14ch] font-display text-[11vw] font-black uppercase leading-[0.88] tracking-[-0.03em] md:text-[5.4vw]">
        Start a conversation
      </h2>

      <!--
        Form left, plate right. The form is the only thing on this page asking
        for effort, so it gets the reading column and the plate stays a quiet
        companion — it explains where the message goes, it does not compete.
      -->
      <div class="mt-10 grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <form id="contact-form" data-rise class="grid gap-5 md:grid-cols-2 lg:col-span-7" novalidate>
        <div class="md:col-span-1">
          <label for="cf-name" class="mb-2 block font-body text-xs uppercase tracking-[0.18em] text-muted">
            Name <span class="text-sage" aria-hidden="true">*</span>
          </label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required class="field" />
          <p class="err" data-err-for="name" role="alert"></p>
        </div>

        <div class="md:col-span-1">
          <label for="cf-email" class="mb-2 block font-body text-xs uppercase tracking-[0.18em] text-muted">
            Email <span class="text-sage" aria-hidden="true">*</span>
          </label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required class="field" />
          <p class="err" data-err-for="email" role="alert"></p>
        </div>

        <div class="md:col-span-2">
          <label for="cf-company" class="mb-2 block font-body text-xs uppercase tracking-[0.18em] text-muted">
            Company <span class="normal-case tracking-normal text-muted">(optional)</span>
          </label>
          <input id="cf-company" name="company" type="text" autocomplete="organization" class="field" />
        </div>

        <div class="md:col-span-2">
          <label for="cf-message" class="mb-2 block font-body text-xs uppercase tracking-[0.18em] text-muted">
            Message <span class="text-sage" aria-hidden="true">*</span>
          </label>
          <textarea id="cf-message" name="message" rows="5" required class="field resize-y"
            placeholder="What are you building, and where do you need help?"></textarea>
          <p class="err" data-err-for="message" role="alert"></p>
        </div>

        <!-- Honeypot. Hidden from people, irresistible to bots. -->
        <div class="hp" aria-hidden="true">
          <label for="cf-website">Website</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-wrap items-center gap-5 md:col-span-2">
          <button type="submit" class="btn"><span data-label>Send message</span></button>
          <p class="font-body text-sm text-bone-dim">
            Or email
            <a class="ul" href="mailto:work.aadityak@gmail.com">work.aadityak@gmail.com</a>
            — I reply within a day.
          </p>
        </div>

        <p id="cf-status" class="font-body text-sm md:col-span-2" role="status" aria-live="polite"></p>
      </form>

      <!-- Companion plate: what happens to the message once it is sent. -->
      <figure data-rise class="hidden lg:col-span-5 lg:block">
        <!--
          Mask on the wrapper, not the image. With the mask on the image the
          overflow clip lands first and leaves a hard edge exactly where the
          fade was supposed to be.
        -->
        <div class="dissolve-all relative h-[32rem] overflow-hidden">
          <img data-drift src="/img/contact-plate.webp" alt="" aria-hidden="true"
            class="absolute inset-0 h-[120%] w-full object-cover opacity-80" width="896" height="1195" loading="lazy" />
        </div>
        <figcaption class="mt-5 border-t border-hair pt-4 font-body text-[13px] leading-relaxed text-bone-dim">
          Every message lands in a table first and mails me second, so a mail provider
          having a bad afternoon can't lose it. Written the same way I'd write it at work.
        </figcaption>
      </figure>
      </div>

      <div data-group class="mt-12 grid gap-8 border-t border-hair pt-7 md:grid-cols-3">
        <div>
          <p class="font-body text-xs uppercase tracking-[0.18em] text-muted">Looking for</p>
          <p class="font-body text-sm text-bone">Backend or platform roles, remote</p>
        </div>
        <div>
          <p class="font-body text-xs uppercase tracking-[0.18em] text-muted">Based in</p>
          <p class="font-body text-sm text-bone">Lucknow, India — IST, 4+ hours overlap with EU and US-East</p>
        </div>
        <div>
          <p class="font-body text-xs uppercase tracking-[0.18em] text-muted">Elsewhere</p>
          <p class="font-body text-sm text-bone">
            <a class="ul" href="https://github.com/aadityakushwaha" target="_blank" rel="noopener">GitHub</a> ·
            <a class="ul" href="https://linkedin.com/in/aadityakushwaha" target="_blank" rel="noopener">LinkedIn</a>
          </p>
        </div>
      </div>

      <p class="mt-12 font-body text-xs uppercase tracking-[0.2em] text-muted">
        Built and hosted by me — <span class="font-editorial text-sm normal-case italic tracking-normal">of course</span>
      </p>
    </div>
  </footer>
</Base>
