---
import Base from "../layouts/Base.astro";

const systems = [
  {
    n: "01",
    name: "Ride-hailing platform",
    org: "Aerovahan",
    years: "2025 — 2026",
    body:
      "Dispatch and matching for a live marketplace: driver-offer caps, radius expansion, dynamic surge, hot-zone broadcast, demand forecasting, and a rider–driver bid flow. I owned the backend, the admin console, and both Flutter apps.",
    facts: ["863 commits", "94 routers", "110 services", "98 migrations", "~135k lines"],
    stack: "FastAPI · SQLAlchemy 2 async · Postgres · Redis · Next.js · Flutter",
  },
  {
    n: "02",
    name: "School-transport safety",
    org: "Aero Squad",
    years: "2026",
    body:
      "Parents watch a bus in real time; schools verify arrivals with a TOTP gate check that works with no signal. Geofenced trips over OSRM map-matching, and a KYC pipeline doing DigiLocker lookups, OCR and face-to-document matching behind circuit breakers.",
    facts: ["372 commits", "22 screens", "zero to shipped in 10 weeks"],
    stack: "FastAPI · PostGIS · OSRM · Flutter · Riverpod · arq",
  },
  {
    n: "03",
    name: "Multi-tenant AI LMS",
    org: "Blitzlearning",
    years: "2026",
    body:
      "Tenant isolation enforced by Postgres row-level security rather than application code — the database refuses cross-tenant reads even when the app is wrong. SCORM, cmi5 and AICC delivery, white-labelled per tenant.",
    facts: ["415 commits", "RLS at the database", "pgvector + Meilisearch"],
    stack: "FastAPI · Postgres 16 · pgvector · Next.js 14 · Turborepo",
  },
  {
    n: "04",
    name: "The network it all runs on",
    org: "Altacee",
    years: "2024 — now",
    body:
      "Designed and operate the estate end to end: dual-WAN with failover, 802.1Q segmentation across three isolated networks, RSTP bridges on redundant NIC pairs. Internal services have no public listener at all — they are reachable only across the mesh.",
    facts: ["17 interfaces", "2 Proxmox estates", "~65-node tailnet", "18 VMs"],
    stack: "OPNsense · Proxmox · Docker Swarm · Traefik · Tailscale · Cloudflare",
  },
];

const oss = [
  { name: "worklog-mcp", stars: null, note: "Six tools that let a coding agent record what it did and why. JSONL, no backend.", href: "https://github.com/aadityakushwaha/worklog-mcp", mine: true },
  { name: "whats4linux", stars: 29, note: "Unofficial WhatsApp desktop client for Linux, in Go.", href: "https://github.com/lugvitc/whats4linux", mine: false },
  { name: "pwncore", stars: 17, note: "CTF platform backend — dynamic per-team flags, Docker-per-team.", href: "https://github.com/lugvitc/pwncore", mine: false },
  { name: "lugtype", stars: 4, note: "Monkeytype fork with an original OneRandom mode.", href: "https://github.com/lugvitc/lugtype", mine: false },
];

const marquee = [
  "FASTAPI", "POSTGRESQL", "ROW-LEVEL SECURITY", "REDIS", "POSTGIS", "PGVECTOR",
  "FLUTTER", "NEXT.JS", "TYPESCRIPT", "PROXMOX", "TAILSCALE", "OPNSENSE",
  "DOCKER SWARM", "MCP", "ARQ", "TRAEFIK",
];
---

<Base
  title="Aaditya Kushwaha — Backend & Platform Engineer"
  description="Backend and platform engineer. Dispatch engines, multi-tenant SaaS, agentic infrastructure — and the network underneath them."
>
  <!-- ============================================================ loader -->
  <div id="loader" class="flex items-end justify-between p-6 md:p-10">
    <span class="font-body text-xs uppercase tracking-[0.3em] text-muted">Aaditya Kushwaha</span>
    <span id="count" class="font-display text-[22vw] leading-[0.78] font-black text-raise tabular-nums md:text-[15vw]">000</span>
  </div>

  <!-- ============================================================== nav -->
  <header class="fixed inset-x-0 top-0 z-50 mix-blend-difference">
    <nav class="flex items-center justify-between px-6 py-6 md:px-10">
      <a href="/" class="font-display text-sm font-black tracking-tight text-bone">AK</a>
      <div class="flex gap-6 font-body text-xs uppercase tracking-[0.18em] text-bone md:gap-10">
        <a href="#systems" class="ul">Systems</a>
        <a href="#writing" class="ul">Writing</a>
        <a href="#contact" class="ul">Contact</a>
      </div>
    </nav>
  </header>

  <!-- ============================================================= hero -->
  <section class="relative flex min-h-svh flex-col justify-between overflow-hidden px-6 pb-8 pt-28 md:px-10 md:pb-10">
    <div data-hero class="hero-art" style="--d:0ms">
      <img data-parallax src="/img/hero.png" alt="" width="1376" height="768" fetchpriority="high" />
    </div>

    <div class="relative z-10 mt-auto">
      <p data-hero class="pre mb-6 max-w-[46ch] font-body text-sm text-bone-dim md:mb-10 md:text-base" style="--d:900ms">
        I build systems that carry load — and stay explainable at 3am.
      </p>

      <!--
        Sized per line rather than uniformly: KUSHWAHA is eight characters and
        carries a W, so at the size AADITYA wants it runs past the right margin.
        Each character is its own span so the line can rise letter by letter.
      -->
      <h1 class="font-display font-black uppercase leading-[0.82] tracking-[-0.035em]">
        <span class="sr-only">Aaditya Kushwaha</span>

        <span data-hero class="mask block" style="--d:120ms" aria-hidden="true">
          <span class="chars in block text-[16.5vw] md:text-[14.5vw]">
            {"Aaditya".split("").map((c, i) => (
              <span style={`transition-delay:${420 + i * 45}ms`}>{c}</span>
            ))}
          </span>
        </span>

        <span data-hero class="mask block" style="--d:240ms" aria-hidden="true">
          <span class="chars in block text-[13.2vw] text-sage md:text-[11.6vw]">
            {"Kushwaha".split("").map((c, i) => (
              <span style={`transition-delay:${540 + i * 45}ms`}>{c}</span>
            ))}
          </span>
        </span>
      </h1>
    </div>

    <div data-hero class="pre relative z-10 mt-10 flex flex-wrap items-end justify-between gap-6 border-t border-hair pt-6" style="--d:1150ms">
      <p class="font-body text-sm uppercase leading-snug tracking-[0.12em] text-muted">
        <span class="block whitespace-nowrap">Backend · Platform · Agentic systems</span>
        <span class="mt-1 block font-editorial text-base normal-case italic tracking-normal text-bone-dim">
          four years, mostly in production
        </span>
      </p>
      <p class="font-body text-xs uppercase tracking-[0.18em] text-muted">Lucknow, India — remote</p>
    </div>
  </section>

  <!-- ========================================================== marquee -->
  <div class="overflow-hidden border-y border-hair py-4">
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="flex shrink-0 items-center" aria-hidden="false">
          {marquee.map((m) => (
            <span class="flex items-center whitespace-nowrap font-body text-xs uppercase tracking-[0.25em] text-muted">
              <span class="px-6">{m}</span>
              <span class="text-sage">/</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- ========================================================== systems -->
  <section id="systems" class="px-6 py-24 md:px-10 md:py-36">
    <div class="pre mb-16 flex items-baseline justify-between border-b border-hair pb-5 md:mb-24">
      <h2 class="font-display text-3xl font-black uppercase tracking-tight md:text-5xl">Selected systems</h2>
      <span class="font-body text-xs uppercase tracking-[0.2em] text-muted">Four of them</span>
    </div>

    <!--
      Two tracks: the left plate is sticky and swaps as the right column
      scrolls, so the artwork changes without the reader losing their place.
      On narrow screens the plate rides above each entry instead.
    -->
    <div class="grid gap-10 md:grid-cols-12 md:gap-14">
      <div class="hidden md:col-span-5 md:block">
        <div class="sticky top-24 aspect-4/5 overflow-hidden border border-hair bg-raise">
          {systems.map((s, i) => (
            <img
              data-plate
              class={`plate h-full w-full object-cover${i === 0 ? " live" : ""}`}
              src={`/img/sys-0${i + 1}.png`}
              alt={`Abstract diagram — ${s.name}`}
              width="880"
              height="1100"
              loading={i === 0 ? "eager" : "lazy"}
            />
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-24 md:col-span-7 md:gap-44">
        {systems.map((s, i) => (
          <article data-case class="pre">
            <img
              class="wipe mb-7 aspect-4/5 w-full border border-hair object-cover md:hidden"
              src={`/img/sys-0${i + 1}.png`}
              alt={`Abstract diagram — ${s.name}`}
              width="880"
              height="1100"
              loading="lazy"
            />

            <div class="flex items-baseline gap-5">
              <span class="font-display text-5xl font-black leading-none text-hair md:text-7xl">{s.n}</span>
              <div>
                <p class="font-body text-xs uppercase tracking-[0.2em] text-sage">{s.org}</p>
                <p class="font-body text-xs uppercase tracking-[0.2em] text-muted">{s.years}</p>
              </div>
            </div>

            <h3 class="mt-6 font-display text-3xl font-black uppercase leading-[0.95] tracking-tight md:text-5xl">
              {s.name}
            </h3>
            <p class="mt-5 max-w-[58ch] font-body text-[15px] leading-relaxed text-bone-dim md:text-lg">{s.body}</p>

            <ul class="mt-7 flex flex-wrap gap-x-7 gap-y-2">
              {s.facts.map((f) => (
                <li class="font-body text-sm tabular-nums text-bone">
                  <span class="mr-2 text-sage">—</span>{f}
                </li>
              ))}
            </ul>

            <p class="mt-6 font-body text-xs uppercase tracking-[0.15em] text-muted">{s.stack}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================== oss -->
  <section class="border-t border-hair bg-raise px-6 py-24 md:px-10 md:py-32">
    <div class="pre mb-14 flex items-baseline justify-between border-b border-hair pb-5">
      <h2 class="font-display text-3xl font-black uppercase tracking-tight md:text-5xl">Open source</h2>
      <span class="font-body text-xs uppercase tracking-[0.2em] text-muted">LUGVITC &amp; mine</span>
    </div>

    <ul>
      {oss.map((o) => (
        <li class="pre border-b border-hair">
          <a
            href={o.href}
            class="group flex flex-col gap-2 py-7 md:flex-row md:items-baseline md:gap-10"
            target="_blank"
            rel="noopener"
          >
            <span class="font-display text-2xl font-black uppercase tracking-tight transition-colors group-hover:text-sage md:w-72 md:shrink-0 md:text-3xl">
              {o.name}
            </span>
            <span class="max-w-[54ch] flex-1 font-body text-sm text-bone-dim md:text-base">{o.note}</span>
            <span class="font-body text-xs uppercase tracking-[0.2em] text-muted md:text-right">
              {o.stars ? `${o.stars} stars` : o.mine ? "New" : ""}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ========================================================== writing -->
  <section id="writing" class="px-6 py-24 md:px-10 md:py-36">
    <div class="pre mb-14 flex items-baseline justify-between border-b border-hair pb-5">
      <h2 class="font-display text-3xl font-black uppercase tracking-tight md:text-5xl">Writing</h2>
      <span class="font-body text-xs uppercase tracking-[0.2em] text-muted">Postmortems, mostly</span>
    </div>

    <p class="pre max-w-[58ch] font-editorial text-xl italic leading-snug text-bone-dim md:text-2xl">
      Things that broke in production, and what the fix actually was.
    </p>

    <ul class="mt-12 flex flex-col">
      <li class="pre border-t border-hair py-7">
        <a href="/writing/agent-review-gap" class="group block">
          <span class="font-body text-xs uppercase tracking-[0.2em] text-sage">Published</span>
          <h3 class="mt-2 max-w-[24ch] font-display text-2xl font-black uppercase leading-[0.98] tracking-tight transition-colors group-hover:text-sage md:text-4xl">
            61% of AI-authored pull requests are never reviewed
          </h3>
          <p class="mt-3 max-w-[58ch] font-body text-sm text-bone-dim">
            What we removed when the author stopped being someone you could ask.
          </p>
        </a>
      </li>

      {[
        ["The outage that taught me ElastiCache cluster mode", "KEYS is blocked, deletes cross slots, and one Uvicorn worker takes the health check down with it."],
        ["Multi-tenant isolation below the application", "Postgres RLS, and what breaks when the policy is subtly wrong."],
        ["Encoding the law as a default-deny", "DPDP, PECR and CAN-SPAM as type-checked code that holds rather than sends."],
      ].map(([t, d]) => (
        <li class="pre border-t border-hair py-7 opacity-55">
          <span class="font-body text-xs uppercase tracking-[0.2em] text-muted">Forthcoming</span>
          <h3 class="mt-2 max-w-[24ch] font-display text-2xl font-black uppercase leading-[0.98] tracking-tight md:text-4xl">{t}</h3>
          <p class="mt-3 max-w-[58ch] font-body text-sm text-bone-dim">{d}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ========================================================== contact -->
  <footer id="contact" class="border-t border-hair px-6 py-24 md:px-10 md:py-32">
    <p class="pre font-body text-xs uppercase tracking-[0.25em] text-muted">Open to remote work</p>

    <a
      href="mailto:work.aadityak@gmail.com"
      class="pre mt-6 block font-display text-[10vw] font-black uppercase leading-[0.85] tracking-[-0.03em] transition-colors hover:text-sage md:text-[7vw]"
    >
      Say hello
    </a>

    <div class="pre mt-16 flex flex-wrap items-end justify-between gap-8 border-t border-hair pt-7">
      <ul class="flex flex-wrap gap-x-8 gap-y-2 font-body text-sm">
        <li><a class="ul" href="mailto:work.aadityak@gmail.com">work.aadityak@gmail.com</a></li>
        <li><a class="ul" href="https://github.com/aadityakushwaha" target="_blank" rel="noopener">GitHub</a></li>
        <li><a class="ul" href="https://linkedin.com/in/aadityakushwaha" target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
      <p class="font-body text-xs uppercase tracking-[0.2em] text-muted">
        Built and hosted by me — <span class="font-editorial text-sm normal-case italic tracking-normal">of course</span>
      </p>
    </div>
  </footer>
</Base>
