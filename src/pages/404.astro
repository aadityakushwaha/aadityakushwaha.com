---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Not found — Aaditya Kushwaha</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b0c0b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..900&family=Familjen+Grotesk:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230b0c0b'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='19' font-weight='800' fill='%23e4e0d3' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E"
    />
  </head>

  <body class="grain">
    <header class="fixed inset-x-0 top-0 z-50">
      <nav class="flex items-center justify-between px-6 py-5 md:px-10">
        <a href="/" class="font-display text-sm font-black tracking-tight text-bone">AK</a>
        <a href="/#writing" class="ul font-body text-xs uppercase tracking-[0.18em] text-bone">Writing</a>
      </nav>
    </header>

    <main class="flex min-h-svh items-center px-6 md:px-10">
      <div class="mx-auto w-full max-w-[104rem]">
        <p class="eyebrow">Error 404</p>
        <h1 class="mt-5 max-w-[12ch] font-display text-[16vw] font-black uppercase leading-[0.84] tracking-[-0.03em] md:text-[9vw]">
          Nothing here
        </h1>
        <p class="mt-7 max-w-[46ch] font-editorial text-2xl italic leading-snug text-bone-dim md:text-3xl">
          The page you asked for doesn't exist — or it moved and I didn't leave a forwarding address.
        </p>
        <div class="mt-10 flex flex-wrap gap-8 border-t border-hair pt-7">
          <a class="ul font-body text-sm uppercase tracking-[0.18em] text-bone" href="/">Home</a>
          <a class="ul font-body text-sm uppercase tracking-[0.18em] text-bone" href="/#writing">Writing</a>
          <a class="ul font-body text-sm uppercase tracking-[0.18em] text-bone" href="/#contact">Contact</a>
        </div>
      </div>
    </main>
  </body>
</html>
