---
import Base from "../../layouts/Base.astro";

/**
 * A real page rather than an anchor on the home page. An index that lives at a
 * URL can be linked, cited and ranked on its own terms; `/#writing` can be
 * none of those things.
 */
const posts = Object.values(
  import.meta.glob<{
    frontmatter: { title: string; description: string; date: string; status?: string; kicker?: string };
    url: string;
  }>("./*.md", { eager: true }),
).sort((a, b) => +new Date(b.frontmatter.date) - +new Date(a.frontmatter.date));

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<Base
  title="Writing — production postmortems | Aaditya Kushwaha"
  description="Postmortems and architecture notes from production systems: ElastiCache cluster mode, Postgres row-level security, silent backup failure, document parsing accuracy, and editor data loss."
>
  <section class="px-6 pb-24 pt-32 md:px-10 md:pt-40 xl:px-16 2xl:px-24">
    <div class="mx-auto max-w-[104rem]">
      <p data-rise class="eyebrow">Writing</p>
      <h1 data-rise class="mt-5 max-w-[18ch] font-display text-[clamp(2.1rem,9.4vw,7rem)] font-black uppercase leading-[0.88] tracking-[-0.03em]">
        Things that broke in production
      </h1>
      <p data-rise class="mt-7 max-w-[62ch] font-editorial text-xl italic leading-snug text-bone-dim sm:text-2xl md:text-3xl">
        What failed, why the tests were green anyway, and what the fix actually was.
        Every number here came out of a repository or a live system.
      </p>

      <ul data-group class="mt-16">
        {posts.map((p) => (
          <li class="border-t border-hair">
            <a href={`${p.url}/`} class="group flex flex-col gap-2 py-7 md:flex-row md:items-baseline md:gap-10">
              <span class="shrink-0 font-body text-xs uppercase tracking-[0.2em] text-sage md:w-52">
                {fmt(p.frontmatter.date)}{p.frontmatter.status ? ` · ${p.frontmatter.status}` : ""}
              </span>
              <span class="block">
                <h2 class="max-w-[28ch] font-display text-[clamp(1.4rem,6vw,2.25rem)] font-black uppercase leading-[0.98] tracking-tight transition-colors group-hover:text-sage">
                  {p.frontmatter.title}
                </h2>
                <p class="mt-3 max-w-[68ch] font-body text-sm leading-relaxed text-bone-dim">
                  {p.frontmatter.description}
                </p>
                {p.frontmatter.kicker && (
                  <p class="mt-3 font-body text-[11px] uppercase tracking-[0.18em] text-muted">{p.frontmatter.kicker}</p>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-14 flex flex-wrap items-center gap-8 border-t border-hair pt-7">
        <a class="ul tap font-body text-sm uppercase tracking-[0.18em] text-bone" href="/">← Home</a>
        <a class="ul tap font-body text-sm uppercase tracking-[0.18em] text-bone" href="/rss.xml">RSS feed</a>
        <a class="ul tap font-body text-sm uppercase tracking-[0.18em] text-bone" href="/#contact">Contact</a>
      </div>
    </div>
  </section>
</Base>
